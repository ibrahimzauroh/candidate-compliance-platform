generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum TenantRole {
  ADMIN
  RECRUITER
  COMPLIANCE_OFFICER
  VIEWER

  @@map("tenant_role")
}

enum ComplianceDocumentType {
  RIGHT_TO_WORK
  BACKGROUND_CHECK
  PROFESSIONAL_CERTIFICATION
  OTHER

  @@map("compliance_document_type")
}

enum ComplianceDocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("compliance_document_status")
}

enum VerificationStatus {
  REQUESTED
  PENDING
  VERIFIED
  FAILED

  @@map("verification_status")
}

enum OutboxEventType {
  RIGHT_TO_WORK_VERIFICATION_REQUESTED

  @@map("outbox_event_type")
}

model Tenant {
  id                 String                      @id @default(uuid()) @db.Uuid
  name               String
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  memberships        TenantMembership[]
  candidates         Candidate[]
  documents          ComplianceDocument[]
  versions           ComplianceDocumentVersion[]
  idempotencyRecords IdempotencyRecord[]
  verificationRequests VerificationRequest[]
  outboxEvents         OutboxEvent[]

  @@map("tenants")
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique @db.Citext
  passwordHash String             @map("password_hash")
  displayName  String             @map("display_name")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  memberships  TenantMembership[]
  verificationRequests VerificationRequest[]

  @@map("users")
}

model TenantMembership {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  userId             String                      @map("user_id") @db.Uuid
  role               TenantRole
  createdAt          DateTime                    @default(now()) @map("created_at")
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user               User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdVersions    ComplianceDocumentVersion[]
  idempotencyRecords IdempotencyRecord[]
  verificationRequests VerificationRequest[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("tenant_memberships")
}

model Candidate {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  fullName       String               @map("full_name")
  email          String               @db.Citext
  roleAppliedFor String               @map("role_applied_for")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents      ComplianceDocument[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id])
  @@map("candidates")
}

model ComplianceDocument {
  id               String                      @id @default(uuid()) @db.Uuid
  tenantId         String                      @map("tenant_id") @db.Uuid
  candidateId      String                      @map("candidate_id") @db.Uuid
  type             ComplianceDocumentType
  currentVersionId String?                     @map("current_version_id") @db.Uuid
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  candidate        Candidate                   @relation(fields: [tenantId, candidateId], references: [tenantId, id], onDelete: Restrict)
  versions         ComplianceDocumentVersion[] @relation("DocumentVersions")
  currentVersion   ComplianceDocumentVersion?  @relation("CurrentDocumentVersion", fields: [tenantId, id, currentVersionId], references: [tenantId, documentId, id], onDelete: Restrict)
  verificationRequests VerificationRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, candidateId, createdAt(sort: Desc), id])
  @@map("compliance_documents")
}

model ComplianceDocumentVersion {
  id                  String                      @id @default(uuid()) @db.Uuid
  tenantId            String                      @map("tenant_id") @db.Uuid
  documentId          String                      @map("document_id") @db.Uuid
  versionNumber       Int                         @map("version_number")
  issueDate           DateTime?                   @map("issue_date") @db.Date
  expiryDate          DateTime?                   @map("expiry_date") @db.Date
  status              ComplianceDocumentStatus    @default(DRAFT)
  supersedesVersionId String?                     @map("supersedes_version_id") @db.Uuid
  createdBy           String                      @map("created_by") @db.Uuid
  createdAt           DateTime                    @default(now()) @map("created_at")
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document            ComplianceDocument          @relation("DocumentVersions", fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  currentForDocuments ComplianceDocument[]        @relation("CurrentDocumentVersion")
  supersedes          ComplianceDocumentVersion?  @relation("VersionSupersession", fields: [tenantId, documentId, supersedesVersionId], references: [tenantId, documentId, id], onDelete: Restrict)
  supersededBy        ComplianceDocumentVersion[] @relation("VersionSupersession")
  createdByMembership TenantMembership            @relation(fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict)
  verificationRequests VerificationRequest[]

  @@unique([tenantId, documentId, versionNumber])
  @@unique([tenantId, documentId, id])
  @@map("compliance_document_versions")
}

model IdempotencyRecord {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  membershipId   String           @map("membership_id") @db.Uuid
  operation      String
  key            String
  requestHash    String           @map("request_hash") @db.Char(64)
  responseStatus Int              @map("response_status")
  responseBody   Json             @map("response_body")
  createdAt      DateTime         @default(now()) @map("created_at")
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership     TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, membershipId, operation, key])
  @@index([tenantId, createdAt])
  @@map("idempotency_records")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  action       String
  recordType   String   @map("record_type")
  recordId     String   @map("record_id") @db.Uuid
  beforeHash   String?  @map("before_hash") @db.Char(64)
  afterHash    String   @map("after_hash") @db.Char(64)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc), id])
  @@index([tenantId, recordType, recordId, createdAt(sort: Desc)])
  @@map("audit_events")
}

model VerificationRequest {
  id                      String                    @id @default(uuid()) @db.Uuid
  tenantId                String                    @map("tenant_id") @db.Uuid
  documentId              String                    @map("document_id") @db.Uuid
  documentVersionId       String                    @map("document_version_id") @db.Uuid
  requestedByUserId       String                    @map("requested_by_user_id") @db.Uuid
  requestedByMembershipId String                    @map("requested_by_membership_id") @db.Uuid
  status                  VerificationStatus        @default(REQUESTED)
  attemptCount            Int                       @default(0) @map("attempt_count")
  failureCode             String?                   @map("failure_code") @db.VarChar(64)
  requestedAt             DateTime                  @default(now()) @map("requested_at")
  startedAt               DateTime?                 @map("started_at")
  completedAt             DateTime?                 @map("completed_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document                ComplianceDocument        @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  documentVersion         ComplianceDocumentVersion @relation(fields: [tenantId, documentId, documentVersionId], references: [tenantId, documentId, id], onDelete: Restrict)
  requestedByUser         User                      @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  requestedByMembership   TenantMembership          @relation(fields: [tenantId, requestedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  outboxEvents            OutboxEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, documentVersionId])
  @@index([tenantId, documentId, requestedAt(sort: Desc)])
  @@map("verification_requests")
}

model OutboxEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  type                  OutboxEventType
  verificationRequestId String              @map("verification_request_id") @db.Uuid
  attempts              Int                 @default(0)
  maxAttempts           Int                 @default(3) @map("max_attempts")
  availableAt           DateTime            @default(now()) @map("available_at")
  lockedAt              DateTime?           @map("locked_at")
  lockedUntil           DateTime?           @map("locked_until")
  lockedBy              String?             @map("locked_by") @db.VarChar(100)
  processedAt           DateTime?           @map("processed_at")
  lastErrorCode         String?             @map("last_error_code") @db.VarChar(64)
  createdAt             DateTime            @default(now()) @map("created_at")
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  verificationRequest   VerificationRequest @relation(fields: [tenantId, verificationRequestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, verificationRequestId, type])
  @@index([processedAt, availableAt, lockedUntil, createdAt])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}
